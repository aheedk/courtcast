generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  googleId               String?                 @unique
  appleId                String?                 @unique
  email                  String                  @unique
  name                   String?
  avatarUrl              String?
  createdAt              DateTime                @default(now())
  savedCourts            SavedCourt[]
  sessions               Session[]
  customCourts           Court[]                 @relation("UserCustomCourts")
  lists                  List[]
  reports                CourtReport[]
  playPlansCreated       PlayPlan[]              @relation("PlayPlanCreator")
  playPlanRsvps          PlayPlanRsvp[]
  courtChatMessages      CourtChatMessage[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Court {
  placeId        String             @id
  name           String
  lat            Float
  lng            Float
  address        String?
  isCustom       Boolean            @default(false)
  visibility     String             @default("public")
  addedByUserId  String?
  addedBy        User?              @relation("UserCustomCourts", fields: [addedByUserId], references: [id])
  fetchedAt      DateTime           @default(now())
  facts          Json?
  factsUpdatedAt DateTime?
  savedBy        SavedCourt[]
  reports        CourtReport[]
  playPlans      PlayPlan[]
  chatMessages   CourtChatMessage[]

  @@index([addedByUserId])
  @@index([visibility])
}

model SavedCourt {
  userId    String
  placeId   String
  sport     String   @default("tennis")
  nickname  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  court     Court    @relation(fields: [placeId], references: [placeId])
  createdAt DateTime @default(now())

  @@id([userId, placeId, sport])
  @@index([userId])
  @@index([userId, sport])
}

model List {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   ListMember[]

  @@index([userId])
}

model ListMember {
  listId    String
  placeId   String
  sport     String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([listId, placeId, sport])
  @@index([listId])
}

model WeatherCache {
  geohash   String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}

model PlacesCache {
  geohash   String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}

model CourtReport {
  id         String   @id @default(cuid())
  placeId    String
  userId     String
  openCourts String?
  condition  String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  court Court @relation(fields: [placeId], references: [placeId])

  @@index([placeId, createdAt(sort: Desc)])
  @@index([userId, placeId, createdAt(sort: Desc)])
}

model PlayPlan {
  id         String   @id @default(cuid())
  shareToken String   @unique @default(uuid())
  creatorId  String
  placeId    String
  sport      String
  startAt    DateTime
  endAt      DateTime
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creator       User           @relation("PlayPlanCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  court         Court          @relation(fields: [placeId], references: [placeId], onDelete: Cascade)
  rsvps         PlayPlanRsvp[]
  notifications Notification[]

  @@index([creatorId, startAt])
  @@index([placeId, startAt])
}

model PlayPlanRsvp {
  planId    String
  userId    String
  status    String   @default("going")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan PlayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([planId, userId])
  @@index([userId, updatedAt(sort: Desc)])
}

model CourtChatMessage {
  id        String    @id @default(cuid())
  placeId   String
  userId    String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  court Court @relation(fields: [placeId], references: [placeId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([placeId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  placeId   String?
  planId    String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan PlayPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model NotificationPreference {
  userId         String  @id
  playableAlerts Boolean @default(true)
  reportAlerts   Boolean @default(true)
  planAlerts     Boolean @default(true)
  chatAlerts     Boolean @default(false)
  browserAlerts  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
