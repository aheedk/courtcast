# Copy this to client/.env.ios for bundled iOS builds.
#
# For the fastest TestFlight shell, use npm run ios:sync:hosted instead;
# that loads https://courtclimate.com directly and does not rely on these
# client API-origin settings.

VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_APPLE_CLIENT_ID=com.courtclimate.app
VITE_APPLE_REDIRECT_URI=https://courtclimate.com/login
VITE_API_BASE_URL=https://courtclimate.com
VITE_DEFAULT_LAT=40.7831
VITE_DEFAULT_LNG=-73.9712
