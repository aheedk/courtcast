{
  "name": "courtclimate-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ios": "tsc -b && vite build --mode ios",
    "ios:add": "cap add ios",
    "ios:copy": "npm run build:ios && cap copy ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:sync:hosted": "npm run build:ios && CAPACITOR_SERVER_URL=https://courtclimate.com cap sync ios",
    "ios:open": "cap open ios",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/core": "^7.6.7",
    "@react-google-maps/api": "^2.20.3",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@capacitor/ios": "^7.6.7",
    "@types/google.accounts": "^0.0.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.2.0"
  }
}
